# .env.example
#
# Copy this file to `.env` and fill in real values only if/when you need
# them. NONE of these are required for the sample-data workflow, the
# synthetic demo, or the FAA-only damage-model pipeline.
#
# NEVER commit a real .env file - it is already listed in .gitignore.

# --- ArcGIS (optional; only needed to publish/read hosted feature layers) ---
# See src/birdstrikegeo/geo/arcgis_adapter.py and ESRI_DISCUSSION_NOTES.md.
# The core local workflow (GeoJSON/GeoPackage/GeoParquet export) does not
# require any of these.
ARCGIS_PORTAL_URL=
ARCGIS_ITEM_ID=
ARCGIS_FEATURE_LAYER_URL=
ARCGIS_API_KEY=

# --- NOAA (optional; only needed to download real hourly weather) ---
NOAA_TOKEN=

# --- Trektellen provenance (required once you use REAL Trektellen data) ---
# These record how you obtained permission to use the export you
# downloaded - see DATA_DOWNLOAD_GUIDE.md and
# src/birdstrikegeo/schemas/trektellen.py:TREKTELLEN_PROVENANCE_FIELDS.
# They are metadata, not secrets, but are kept here so the values you
# actually used are easy to find alongside other environment config.
TREKTELLEN_SOURCE_DESCRIPTION=
TREKTELLEN_PERMISSION_REFERENCE=
